# --- Server Config ---
PORT=5000
SECRET_KEY=jobcraft_secret_key_local_dev_99

# --- AI Configuration ---
# Your Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Job Boards (Adzuna) ---
# Sign up at https://developer.adzuna.com/ to get your credentials
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID_HERE
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY_HERE

# --- Job Search Filters ---
# Comma-separated list of roles/keywords to monitor
DEFAULT_KEYWORDS=python developer,software engineer,backend developer
# Default country code (in=India, us=United States, gb=United Kingdom, ca=Canada, etc.)
DEFAULT_COUNTRY=in
# Preferred city or 'remote'
DEFAULT_LOCATION=remote

# --- Email Recruiter Tracker ---
# Gmail IMAP settings (if using Gmail, generate an App Password)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_ADDRESS=your.email@gmail.com
# Google App Password (not your main password, must have 2FA enabled on your Google Account)
EMAIL_PASSWORD=your_gmail_app_password
